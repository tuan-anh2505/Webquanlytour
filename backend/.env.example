# Sao chép sang .env khi cài mới; không ghi đè .env hiện có.
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=webquanlytour_v2
DB_TIMEZONE=+07:00
# Tạo chuỗi ngẫu nhiên riêng ít nhất 32 byte; không dùng giá trị mẫu làm bí mật thật.
JWT_SECRET=
JWT_EXPIRES_IN=8h
PUBLIC_ORIGIN=http://localhost:5173
# Cổng vận hành riêng. Đổi đường dẫn cần đồng bộ frontend VITE_INTERNAL_AUTH_PATH.
INTERNAL_AUTH_PATH=/api/operations/auth
INTERNAL_JWT_EXPIRES_IN=2h
# Development có thể bỏ trống để dẫn xuất khóa riêng; production bắt buộc secret khác JWT_SECRET.
INTERNAL_JWT_SECRET=
# Mặc định chỉ loopback. Khi có VPN, khai báo IP/CIDR của máy/mạng nội bộ được phép.
INTERNAL_ALLOWED_IPS=127.0.0.1,::1
# Chỉ khai báo proxy thực sự kiểm soát được; proxy cần thay thế header client forwarding.
TRUSTED_PROXY_CIDRS=
# Đặt chỗ: giữ tối đa 15 phút; job thu hồi chỗ mỗi 60 giây.
BOOKING_HOLD_MINUTES=15
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_INTERVAL_MS=60000
BOOKING_EXPIRY_BATCH_SIZE=100
# Chỉ có cổng thử nghiệm. Production vô hiệu hóa mock, chưa có cổng thu tiền thật.
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_SECRET=
