# Sao chép sang .env khi cài mới; không ghi đè .env hiện có.
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=webquanlytour_v2
DB_TIMEZONE=+07:00
# Tạo chuỗi ngẫu nhiên riêng ít nhất 32 byte; không dùng giá trị mẫu làm bí mật thật.
JWT_SECRET=
JWT_EXPIRES_IN=8h
PUBLIC_ORIGIN=http://localhost:5173
